# Kuveyt Türk API Market uygulama bilgileri.
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` git'e girmez.
# Değerleri https://developer.kuveytturk.com.tr -> Uygulamalarım sayfasından alabilirsiniz.

KUVEYTTURK_CLIENT_ID=
KUVEYTTURK_CLIENT_SECRET=
# Uygulamayı oluştururken girdiğiniz Redirect URI ile birebir aynı olmalı.
KUVEYTTURK_REDIRECT_URI=http://localhost:8000/callback
# İmza için kullanılan RSA private key: dosya yolu ya da PEM içeriğinin kendisi.
KUVEYTTURK_PRIVATE_KEY=.secrets/private_key.pem
# sandbox | production
KUVEYTTURK_ENVIRONMENT=sandbox
